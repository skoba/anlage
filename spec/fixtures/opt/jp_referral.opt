                                                <archetype_id>
                                                    <value>openEHR-EHR-CLUSTER.electronic_communication.v1</value>
                                                </archetype_id>
                                                <term_definitions code="at0000">
                                                    <items id="text">電子的な連絡先</items>
                                                    <items id="description">特定の種別の電子的な連絡先に関する詳細情報。</items>
                                                </term_definitions>
                                                <term_definitions code="at0001">
                                                    <items id="text">種別</items>
                                                    <items id="description">電子的な連絡先の種別または形式。</items>
                                                    <items id="comment">DV_CODED_TEXT の値セットを用いて、医療でよく使われる電子的な連絡先を記録できる。それ以外の種別が必要な場合は、テンプレート内で DV_TEXT データ型を用いる。ソーシャルメディアやビデオ会議の URL なども記録できる。</items>
                                                </term_definitions>
                                                <term_definitions code="at0002">
                                                    <items id="text">値</items>
                                                    <items id="description">「種別」に応じて連絡先を一意に表す英数字の組み合わせ。</items>
                                                    <items id="comment">例：市外局番と固定電話番号またはポケットベル番号の組み合わせ、国番号と携帯電話番号の組み合わせ、電子メールアドレス。</items>
                                                </term_definitions>
                                                <term_definitions code="at0003">
                                                    <items id="text">用途</items>
                                                    <items id="description">指定した種別の電子的な連絡先を何のために使うかを示す。</items>
                                                </term_definitions>
                                                <term_definitions code="at0004">
                                                    <items id="text">コメント</items>
                                                    <items id="description">他の項目には収まらない電子的な連絡先についての追加の記述。</items>
                                                </term_definitions>
                                                <term_definitions code="at0005">
                                                    <items id="text">携帯電話</items>
                                                    <items id="description">SMS または音声通話に用いる。</items>
                                                </term_definitions>
                                                <term_definitions code="at0006">
                                                    <items id="text">固定電話</items>
                                                    <items id="description"></items>
                                                </term_definitions>
                                                <term_definitions code="at0007">
                                                    <items id="text">電子メール</items>
                                                    <items id="description"></items>
                                                </term_definitions>
                                                <term_definitions code="at0008">
                                                    <items id="text">ポケットベル</items>
                                                    <items id="description"></items>
                                                </term_definitions>
                                                <term_definitions code="at0009">
                                                    <items id="text">ファクシミリ</items>
                                                    <items id="description"></items>
                                                </term_definitions>
                                                <term_definitions code="at0010">
                                                    <items id="text">業務用</items>
                                                    <items id="description"></items>
                                                </term_definitions>
                                                <term_definitions code="at0011">
                                                    <items id="text">個人用</items>
                                                    <items id="description"></items>
                                                </term_definitions>
                                                <term_definitions code="at0012">
                                                    <items id="text">業務用・個人用の両方</items>
                                                    <items id="description"></items>
                                                </term_definitions>
                                                <term_definitions code="at0013">
                                                    <items id="text">追加の詳細情報</items>
                                                    <items id="description">電子的な連絡先に関する追加の詳細情報。</items>
                                                </term_definitions>
                                            </children>
