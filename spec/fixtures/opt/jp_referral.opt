                                                        <interval>
                                                            <lower_included>true</lower_included>
                                                            <upper_included>false</upper_included>
                                                            <lower_unbounded>false</lower_unbounded>
                                                            <upper_unbounded>true</upper_unbounded>
                                                            <lower>1</lower>
                                                        </interval>
                                                    </cardinality>
                                                </attributes>
                                                <archetype_id>
                                                    <value>openEHR-EHR-CLUSTER.address.v1</value>
                                                </archetype_id>
                                                <term_definitions code="at0000">
                                                    <items id="text">住所</items>
                                                    <items id="description">人、建物、または目印となる場所の所在に関する詳細情報。</items>
                                                </term_definitions>
                                                <term_definitions code="at0001">
                                                    <items id="text">住所行</items>
                                                    <items id="description">場所を特定する手がかりとなる、街区レベルまたは私書箱の関連する詳細情報をすべて表す非構造化の住所行。</items>
                                                    <items id="comment">このデータエレメントの出現回数は 0..* に設定されており、指定した「市区町村」の中で「街区レベル」の詳細を記録する必要のある非常に多様な方法を、1つ以上の自由記述の「住所行」データエレメントで表せる。複数の住所行はテンプレートで「住所行 1」「住所行 2」などと名前を変えて表せる。例：「7A/52 Davis Street」、または住所行 1 を「Apartment 7A」とし住所行 2 を「52 Davis Street」とする；「RMB 725, Princes Highway」のような路上郵便受けの場所；あるいは「Corner of Smith &amp; Brown Streets」や「Second house north of the general store with the red door」のような説明的な目印。日本の住所では、町域・丁目・番地・号・建物名・部屋番号（例：「本町一丁目2番3号 ○○ビル 401」）をここに記録する。</items>
                                                </term_definitions>
                                                <term_definitions code="at0002">
                                                    <items id="text">市区町村</items>
                                                    <items id="description">住所を含む最下位の地域の名称。</items>
                                                    <items id="comment">例：郊外、町、市、集落、村、または地域社会。可能であれば、外部用語集によりコード化することが望ましい。例：「Fitzroy」、「Manchester」、「Kingston」または「Bergen」。日本の住所では市区町村（政令指定都市では市と区）が該当し、JIS X 0402 の全国地方公共団体コードでコード化できる。</items>
                                                </term_definitions>
                                                <term_definitions code="at0003">
                                                    <items id="text">地区／郡</items>
                                                    <items id="description">住所を含む地方自治体の区域または地理的区域の名称。</items>
                                                    <items id="comment">可能であれば、外部用語集によりコード化することが望ましい。例：オーストラリア・ビクトリア州の地方自治体「Surf Coast」と「Yarra」、ジャマイカの教区「Saint Andrew」と「Kingston」。日本の住所では、町村の場合の郡が該当する（政令指定都市の区は「市区町村」側に記録する）。</items>
                                                </term_definitions>
                                                <term_definitions code="at0004">
                                                    <items id="text">都道府県／州</items>
                                                    <items id="description">住所を含む主要な行政区域または地理的区域の名称。</items>
                                                    <items id="comment">可能であれば、外部用語集によりコード化することが望ましい。例：オーストラリアの「New South Wales」と「Queensland」、カナダの「British Columbia」と「Nova Scotia」、ジャマイカの「Cornwall」「Middlesex」「Surrey」の各カウンティ。日本の住所では都道府県が該当し、JIS X 0401 の都道府県コードでコード化できる。</items>
                                                </term_definitions>
                                                <term_definitions code="at0005">
                                                    <items id="text">郵便番号</items>
                                                    <items id="description">該当する郵便配達サービスが定める、住所を含む郵便配達区域のコード。</items>
                                                    <items id="comment">ポストコードや ZIP コードとも呼ばれる。日本の郵便番号は 7 桁（例：100-0001）。&#13;
</items>
                                                </term_definitions>
                                                <term_definitions code="at0006">
                                                    <items id="text">国</items>
                                                    <items id="description">住所を含む国の名称。</items>
                                                    <items id="comment">例：オーストラリア、カナダ、ジャマイカ、またはノルウェー。EN ISO 3166-1 の 2 文字国コードのような外部用語集によるコード化を推奨する（日本は JP）。</items>
                                                </term_definitions>
                                                <term_definitions code="at0007">
                                                    <items id="text">緯度</items>
                                                    <items id="description">住所の地理的位置の水平（y）座標。</items>
                                                    <items id="comment">緯度は赤道以北を正の値、赤道以南を負の値で表す。例：エッフェル塔の緯度は 48.858093。</items>
                                                </term_definitions>
                                                <term_definitions code="at0008">
                                                    <items id="text">経度</items>
                                                    <items id="description">住所の地理的位置の水平（x）座標。</items>
                                                    <items id="comment">経度は本初子午線以西を負の値、本初子午線以東を正の値で表す。例：エッフェル塔の経度は 2.294694。</items>
                                                </term_definitions>
                                                <term_definitions code="at0009">
                                                    <items id="text">高度</items>
                                                    <items id="description">住所の高さまたは深さを表す、地理的位置の垂直座標。</items>
                                                    <items id="comment">例：エッフェル塔の頂上の高度は +324 m。</items>
                                                </term_definitions>
                                                <term_definitions code="at0010">
                                                    <items id="text">種別</items>
                                                    <items id="description">住所の種別。</items>
                                                    <items id="comment">例：物理的所在地または郵送先。</items>
                                                </term_definitions>
                                                <term_definitions code="at0011">
                                                    <items id="text">物理的所在地</items>
                                                    <items id="description">訪問できる物理的な場所。</items>
                                                </term_definitions>
                                                <term_definitions code="at0012">
                                                    <items id="text">郵送先</items>
                                                    <items id="description">手紙や小包の郵送先として使う住所。</items>
                                                </term_definitions>
                                                <term_definitions code="at0013">
                                                    <items id="text">両方</items>
                                                    <items id="description">物理的な場所の住所で、郵送先としても使うもの。</items>
                                                </term_definitions>
                                                <term_definitions code="at0014">
                                                    <items id="text">用途</items>
                                                    <items id="description">住所の主な目的または用途。</items>
                                                </term_definitions>
                                                <term_definitions code="at0015">
                                                    <items id="text">事業所</items>
                                                    <items id="description">事業所や事務所の物理的な場所の住所。</items>
                                                </term_definitions>
                                                <term_definitions code="at0016">
                                                    <items id="text">自宅</items>
                                                    <items id="description">個人が常時居住している場所の住所。</items>
                                                </term_definitions>
                                                <term_definitions code="at0017">
                                                    <items id="text">一時滞在先</items>
                                                    <items id="description">個人が一時的に居住している場所の住所。</items>
                                                </term_definitions>
                                                <term_definitions code="at0018">
                                                    <items id="text">コメント</items>
                                                    <items id="description">他の項目には収まらない住所についての追加の記述。</items>
                                                </term_definitions>
                                                <term_definitions code="at0019">
                                                    <items id="text">地図 URL</items>
                                                    <items id="description">オンライン地図上の場所へのリンク。</items>
                                                    <items id="comment">例：Google マップや iOS のマップ上の場所。</items>
                                                </term_definitions>
                                                <term_definitions code="at0020">
                                                    <items id="text">構造化された住所表記</items>
                                                    <items id="description">構造化された詳細な住所表記または拡張。</items>
                                                    <items id="comment">例：構造化された細かな粒度の住所を表す、または一貫した方法で単一の「住所行」を組み立てるために連結できる標準化された概念として使う。日本の住所では、都道府県・市区町村・町域・丁目・番地・号・建物名・部屋番号とそれぞれの読みを持つ CLUSTER をここに入れる想定。</items>
                                                </term_definitions>
                                                <term_definitions code="at0021">
                                                    <items id="text">位置情報コード</items>
                                                    <items id="description">正確な地理的位置を表す一意の識別子。</items>
                                                    <items id="comment">ジオコードとも呼ばれる。例：経度、緯度、±高度を連結した GPS 座標。Open Location Code または Plus Code。ユニバーサル横メルカトル（UTM）および geohash。</items>
                                                </term_definitions>
                                            </children>
