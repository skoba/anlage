                                                <archetype_id>
                                                    <value>openEHR-EHR-CLUSTER.organisation.v1</value>
                                                </archetype_id>
                                                <term_definitions code="at0000">
                                                    <items id="text">診療科</items>
                                                    <items id="description">1人以上で構成され、特定の目的を持つ組織。</items>
                                                    <items id="comment">例：企業、機関、協会、ネットワーク、診療部門、地域団体、診療グループ、支払機関・保険者、ケアチーム、またはケアや支援を提供する近隣住民の集まり。</items>
                                                </term_definitions>
                                                <term_definitions code="at0001">
                                                    <items id="text">名称</items>
                                                    <items id="description">組織の名称またはラベル（非構造情報）。</items>
                                                    <items id="comment">例：「Royal Children's Hospital」、「ABC District Nursing Service」、「YNWA Oslo」、または「JB Smith Lawyers」。</items>
                                                </term_definitions>
                                                <term_definitions code="at0002">
                                                    <items id="text">連絡担当者</items>
                                                    <items id="description">組織内の1人以上の人に関する詳細情報。</items>
                                                </term_definitions>
                                                <term_definitions code="at0003">
                                                    <items id="text">識別子</items>
                                                    <items id="description">組織に関連付けられた識別子。</items>
                                                    <items id="comment">このデータエレメントの出現回数は 0..* に設定されており、複数の識別子を記録できる。ID データ型には、ID の値、種類、発行者、割り当て先を記録する複数の下位要素がある点に注意。</items>
                                                </term_definitions>
                                                <term_definitions code="at0004">
                                                    <items id="text">役割</items>
                                                    <items id="description">個人またはケア対象者に対する組織の関係または役割。</items>
                                                    <items id="comment">例：腫瘍専門医、緩和ケアの訪問看護サービス、または非公式な支援ネットワーク。</items>
                                                </term_definitions>
                                                <term_definitions code="at0005">
                                                    <items id="text">住所</items>
                                                    <items id="description">組織の詳細な住所。</items>
                                                </term_definitions>
                                                <term_definitions code="at0017">
                                                    <items id="text">追加の詳細情報</items>
                                                    <items id="description">組織に関する追加の詳細情報。</items>
                                                </term_definitions>
                                                <term_definitions code="at0019">
                                                    <items id="text">コメント</items>
                                                    <items id="description">他の項目には収まらない組織についての追加の記述。</items>
                                                </term_definitions>
                                                <term_definitions code="at0021">
                                                    <items id="text">親組織</items>
                                                    <items id="description">この組織を傘下組織または子会社として含む、より大きな組織。</items>
                                                </term_definitions>
                                                <term_definitions code="at0022">
                                                    <items id="text">電子的な連絡先</items>
                                                    <items id="description">組織の電子的な連絡先（1種類以上）の詳細情報。</items>
                                                </term_definitions>
                                            </children>
                                            <cardinality>
                                                <is_ordered>false</is_ordered>
                                                <is_unique>false</is_unique>
                                                <interval>
                                                    <lower_included>true</lower_included>
                                                    <upper_included>false</upper_included>
                                                    <lower_unbounded>false</lower_unbounded>
                                                    <upper_unbounded>true</upper_unbounded>
                                                    <lower>1</lower>
                                                </interval>
                                            </cardinality>
                                        </attributes>
                                        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                                            <rm_attribute_name>name</rm_attribute_name>
                                            <existence>
                                                <lower_included>true</lower_included>
                                                <upper_included>true</upper_included>
                                                <lower_unbounded>false</lower_unbounded>
                                                <upper_unbounded>false</upper_unbounded>
                                                <lower>1</lower>
                                                <upper>1</upper>
                                            </existence>
                                            <match_negated>false</match_negated>
                                            <children xsi:type="C_COMPLEX_OBJECT">
                                                <rm_type_name>DV_TEXT</rm_type_name>
                                                <occurrences>
                                                    <lower_included>true</lower_included>
                                                    <upper_included>true</upper_included>
                                                    <lower_unbounded>false</lower_unbounded>
                                                    <upper_unbounded>false</upper_unbounded>
                                                    <lower>1</lower>
                                                    <upper>1</upper>
                                                </occurrences>
                                                <node_id></node_id>
                                                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                                                    <rm_attribute_name>value</rm_attribute_name>
                                                    <existence>
                                                        <lower_included>true</lower_included>
                                                        <upper_included>true</upper_included>
                                                        <lower_unbounded>false</lower_unbounded>
                                                        <upper_unbounded>false</upper_unbounded>
                                                        <lower>1</lower>
                                                        <upper>1</upper>
                                                    </existence>
                                                    <match_negated>false</match_negated>
                                                    <children xsi:type="C_PRIMITIVE_OBJECT">
                                                        <rm_type_name>STRING</rm_type_name>
                                                        <occurrences>
                                                            <lower_included>true</lower_included>
                                                            <upper_included>true</upper_included>
                                                            <lower_unbounded>false</lower_unbounded>
                                                            <upper_unbounded>false</upper_unbounded>
                                                            <lower>1</lower>
                                                            <upper>1</upper>
                                                        </occurrences>
                                                        <node_id></node_id>
                                                        <item xsi:type="C_STRING">
                                                            <list>紹介先医療機関</list>
                                                        </item>
                                                    </children>
                                                </attributes>
                                            </children>
                                        </attributes>
                                        <archetype_id>
                                            <value>openEHR-EHR-CLUSTER.organisation.v1</value>
                                        </archetype_id>
                                        <term_definitions code="at0000">
                                            <items id="text">紹介先医療機関</items>
                                            <items id="description">1人以上で構成され、特定の目的を持つ組織。</items>
                                            <items id="comment">例：企業、機関、協会、ネットワーク、診療部門、地域団体、診療グループ、支払機関・保険者、ケアチーム、またはケアや支援を提供する近隣住民の集まり。</items>
                                        </term_definitions>
                                        <term_definitions code="at0001">
                                            <items id="text">名称</items>
                                            <items id="description">組織の名称またはラベル（非構造情報）。</items>
                                            <items id="comment">例：「Royal Children's Hospital」、「ABC District Nursing Service」、「YNWA Oslo」、または「JB Smith Lawyers」。</items>
                                        </term_definitions>
                                        <term_definitions code="at0002">
                                            <items id="text">連絡担当者</items>
                                            <items id="description">組織内の1人以上の人に関する詳細情報。</items>
                                        </term_definitions>
                                        <term_definitions code="at0003">
                                            <items id="text">識別子</items>
                                            <items id="description">組織に関連付けられた識別子。</items>
                                            <items id="comment">このデータエレメントの出現回数は 0..* に設定されており、複数の識別子を記録できる。ID データ型には、ID の値、種類、発行者、割り当て先を記録する複数の下位要素がある点に注意。</items>
                                        </term_definitions>
                                        <term_definitions code="at0004">
                                            <items id="text">役割</items>
                                            <items id="description">個人またはケア対象者に対する組織の関係または役割。</items>
                                            <items id="comment">例：腫瘍専門医、緩和ケアの訪問看護サービス、または非公式な支援ネットワーク。</items>
                                        </term_definitions>
                                        <term_definitions code="at0005">
                                            <items id="text">住所</items>
                                            <items id="description">組織の詳細な住所。</items>
                                        </term_definitions>
                                        <term_definitions code="at0017">
                                            <items id="text">追加の詳細情報</items>
                                            <items id="description">組織に関する追加の詳細情報。</items>
                                        </term_definitions>
                                        <term_definitions code="at0019">
                                            <items id="text">コメント</items>
                                            <items id="description">他の項目には収まらない組織についての追加の記述。</items>
                                        </term_definitions>
                                        <term_definitions code="at0021">
                                            <items id="text">親組織</items>
                                            <items id="description">この組織を傘下組織または子会社として含む、より大きな組織。</items>
                                        </term_definitions>
                                        <term_definitions code="at0022">
                                            <items id="text">電子的な連絡先</items>
                                            <items id="description">組織の電子的な連絡先（1種類以上）の詳細情報。</items>
                                        </term_definitions>
                                    </children>
                                    <children xsi:type="ARCHETYPE_SLOT">
                                        <rm_type_name>CLUSTER</rm_type_name>
                                        <occurrences>
                                            <lower_included>true</lower_included>
                                            <upper_included>false</upper_included>
                                            <lower_unbounded>false</lower_unbounded>
                                            <upper_unbounded>true</upper_unbounded>
                                            <lower>0</lower>
                                        </occurrences>
                                        <node_id>at0128</node_id>
                                        <includes>
                                            <string_expression>archetype_id/value matches {/openEHR-EHR-CLUSTER\.distribution\.v1/}</string_expression>
                                            <expression xsi:type="EXPR_BINARY_OPERATOR">
                                                <type>Boolean</type>
                                                <operator>2007</operator>
                                                <precedence_overridden>false</precedence_overridden>
                                                <left_operand xsi:type="EXPR_LEAF">
                                                    <type>String</type>
                                                    <item xsi:type="xs:string" xmlns:xs="http://www.w3.org/2001/XMLSchema">archetype_id/value</item>
                                                    <reference_type>attribute</reference_type>
                                                </left_operand>
                                                <right_operand xsi:type="EXPR_LEAF">
                                                    <type>String</type>
                                                    <item xsi:type="C_STRING">
                                                        <pattern>openEHR-EHR-CLUSTER\.distribution\.v1</pattern>
                                                    </item>
                                                    <reference_type>constraint</reference_type>
                                                </right_operand>
                                            </expression>
                                        </includes>
                                    </children>
                                    <children xsi:type="ARCHETYPE_SLOT">
                                        <rm_type_name>CLUSTER</rm_type_name>
                                        <occurrences>
                                            <lower_included>true</lower_included>
                                            <upper_included>false</upper_included>
                                            <lower_unbounded>false</lower_unbounded>
                                            <upper_unbounded>true</upper_unbounded>
                                            <lower>0</lower>
                                        </occurrences>
                                        <node_id>at0112</node_id>
                                        <includes>
                                            <string_expression>archetype_id/value matches {/.*/}</string_expression>
                                            <expression xsi:type="EXPR_BINARY_OPERATOR">
                                                <type>Boolean</type>
                                                <operator>2007</operator>
                                                <precedence_overridden>false</precedence_overridden>
                                                <left_operand xsi:type="EXPR_LEAF">
                                                    <type>String</type>
                                                    <item xsi:type="xs:string" xmlns:xs="http://www.w3.org/2001/XMLSchema">archetype_id/value</item>
                                                    <reference_type>attribute</reference_type>
                                                </left_operand>
                                                <right_operand xsi:type="EXPR_LEAF">
                                                    <type>String</type>
                                                    <item xsi:type="C_STRING">
                                                        <pattern>.*</pattern>
                                                    </item>
                                                    <reference_type>constraint</reference_type>
                                                </right_operand>
                                            </expression>
                                        </includes>
                                    </children>
                                    <cardinality>
                                        <is_ordered>false</is_ordered>
                                        <is_unique>false</is_unique>
                                        <interval>
                                            <lower_included>true</lower_included>
                                            <upper_included>false</upper_included>
                                            <lower_unbounded>false</lower_unbounded>
                                            <upper_unbounded>true</upper_unbounded>
                                            <lower>1</lower>
                                        </interval>
                                    </cardinality>
                                </attributes>
                            </children>
                        </attributes>
                        <archetype_id>
                            <value>openEHR-EHR-INSTRUCTION.service_request.v1</value>
                        </archetype_id>
                        <term_definitions code="at0000">
                            <items id="text">サービス依頼</items>
                            <items id="description">医療従事者、医療機関、または事業者が提供する保健医療関連のサービスや活動の依頼。</items>
                        </term_definitions>
                        <term_definitions code="at0001">
                            <items id="text">現在のアクティビティ</items>
                            <items id="description">現在のアクティビティ。</items>
                        </term_definitions>
                        <term_definitions code="at0008">
                            <items id="text">Tree</items>
                            <items id="description">@ internal @</items>
                        </term_definitions>
                        <term_definitions code="at0009">
                            <items id="text">Tree</items>
                            <items id="description">@ internal @</items>
                        </term_definitions>
                        <term_definitions code="at0010">
                            <items id="text">依頼者オーダー識別子</items>
                            <items id="description">依頼側の臨床システムが付与したローカルな識別子。</items>
                            <items id="comment">通常、HL7 の Placer Order Identifier に相当する。</items>
                        </term_definitions>
                        <term_definitions code="at0011">
                            <items id="text">受領者オーダー識別子</items>
                            <items id="description">サービス依頼を受領する医療従事者または医療機関が、その依頼に付与したローカルな識別子。</items>
                            <items id="comment">通常、HL7 の Filler Order Identifier に相当する。</items>
                        </term_definitions>
                        <term_definitions code="at0040">
                            <items id="text">サービス実施予定</items>
                            <items id="description">サービスを提供する日時、または許容される日時の範囲。</items>
                            <items id="comment">このデータエレメントは、単一のサービスのタイミングを、日付と時刻、日付の範囲、または「次に空いている枠」のような表現を可能にするテキスト記述子として記録できるようにする。実際には、医療従事者はサービスのオーダーを「3か月後、6か月後、12か月後に再診」のような大まかなタイミングで考えることが多い。臨床システムは動作にもっと正確なパラメータを必要とするため、この「3か月」は通常、記録日から3か月後の正確な日付に変換され、このデータエレメントを用いて保存される。複雑なタイミングや一連のタイミングが必要な場合は、「複雑なタイミング」SLOT 内で CLUSTER.service_direction archetypeを用いる。その場合、このデータエレメントは冗長になる。</items>
                        </term_definitions>
                        <term_definitions code="at0062">
                            <items id="text">紹介目的</items>
                            <items id="description">依頼の理由を述べる短い語句。紹介目的。主訴(主たる訴え)を含めて記載する</items>
                            <items id="comment">利用可能であれば、「依頼理由」はコード体系によりコード化することが望ましい。このデータエレメントは複数回の出現を許容し、必要に応じて利用者が複数の回答を記録できる。例：「糖尿病合併症の管理」。</items>
                        </term_definitions>
                        <term_definitions code="at0064">
                            <items id="text">理由の説明</items>
                            <items id="description">依頼理由に関する叙述的な説明。</items>
                            <items id="comment">例：「患者の糖尿病は最近コントロールが難しくなっており、腎機能も悪化している」。</items>
                        </term_definitions>
                        <term_definitions code="at0065">
                            <items id="text">意図</items>
                            <items id="description">依頼の意図の説明。</items>
                            <items id="comment">例：専門医への紹介には、専門医が患者の診療責任を引き継ぐという意図もあれば、治療選択肢についてセカンドオピニオンを求めるという意図もある。利用可能であれば、「意図」はコード体系によりコード化することが望ましい。このデータエレメントは複数回の出現を許容し、必要に応じて利用者が複数の回答を記録できる。</items>
                        </term_definitions>
                        <term_definitions code="at0068">
                            <items id="text">緊急度</items>
                            <items id="description">サービス依頼の緊急度。</items>
                            <items id="comment">「緊急」と「至急」の具体的な定義は、臨床の文脈、臨床システム、依頼そのものの性質によって異なるため、本archetypeでは定義していない。明示的なタイミングが必要な場合は、サービス期間を明確に記載すること。</items>
                        </term_definitions>
                        <term_definitions code="at0076">
                            <items id="text">補足情報</items>
                            <items id="description">補足情報が依頼に続いて送付される。</items>
                            <items id="comment">追加の情報があることが判明しており、利用可能になり次第送付する場合に TRUE として記録する。例：結果待ちの検査。</items>
                        </term_definitions>
                        <term_definitions code="at0078">
                            <items id="text">情報の説明</items>
                            <items id="description">補足情報の説明。</items>
                        </term_definitions>
                        <term_definitions code="at0112">
                            <items id="text">Extension</items>
                            <items id="description">ローカルコンテンツを捕捉するため、あるいは他の参照モデルや形式手法と整合させるために必要な追加情報。</items>
                            <items id="comment">例：ローカルな情報要件や、FHIR または CIMI の相当するものに適合させるための追加メタデータ。</items>
                        </term_definitions>
                        <term_definitions code="at0116">
                            <items id="text">患者側からの要件</items>
                            <items id="description">患者がサービスの提供に出向く、または参加するのを支えるために患者側から求められる、言語、移動手段、その他の要件。</items>
                        </term_definitions>
                        <term_definitions code="at0121">
                            <items id="text">サービス名</items>
                            <items id="description">依頼する単一のサービスまたは活動の名称。</items>
                            <items id="comment">利用可能であれば、「サービス名」はコード体系によりコード化することが望ましい。例：糖尿病管理のための内分泌専門医への「紹介」。</items>
                        </term_definitions>
                        <term_definitions code="at0127">
                            <items id="text">依頼状態</items>
                            <items id="description">依頼者が示す、サービス依頼の状態。</items>
                            <items id="comment">状態は、これが最初の依頼なのか、変更または補足情報の提供のためのフォローアップの依頼なのかを示すために用いる。可能であれば用語集によるコード化が望ましい。</items>
                        </term_definitions>
                        <term_definitions code="at0128">
                            <items id="text">配布先リスト</items>
                            <items id="description">通信の写しを必要とする追加の医療従事者、医療機関、または事業者に関する詳細情報。</items>
                        </term_definitions>
                        <term_definitions code="at0132">
                            <items id="text">詳細記録</items>
                            <items id="description">依頼するサービスに関する追加の詳細情報。</items>
                            <items id="comment">例：臨床検査依頼における検体の詳細、処置依頼における解剖学的部位。</items>
                        </term_definitions>
                        <term_definitions code="at0135">
                            <items id="text">説明</items>
                            <items id="description">依頼するサービスに関する叙述的な説明。</items>
                            <items id="comment">このデータ項目は、名称で示したサービスをより詳しく説明するために用いる。提供の方法、患者の懸念、サービス提供の際に生じる可能性のある問題などを含む。</items>
                        </term_definitions>
                        <term_definitions code="at0136">
                            <items id="text">緊急</items>
                            <items id="description">依頼には即時の対応が必要である。</items>
                        </term_definitions>
                        <term_definitions code="at0137">
                            <items id="text">至急</items>
                            <items id="description">依頼には優先的な対応が必要である。</items>
                        </term_definitions>
                        <term_definitions code="at0138">
                            <items id="text">通常</items>
                            <items id="description">依頼には優先的な予定調整は必要ない。</items>
                        </term_definitions>
                        <term_definitions code="at0141">
                            <items id="text">依頼者</items>
                            <items id="description">サービスを依頼する医療従事者または医療機関に関する詳細情報。</items>
                        </term_definitions>
                        <term_definitions code="at0142">
                            <items id="text">受領者</items>
                            <items id="description">サービス依頼を受領する医療従事者または医療機関に関する詳細情報。</items>
                        </term_definitions>
                        <term_definitions code="at0144">
                            <items id="text">サービス期間の終了</items>
                            <items id="description">このサービスを提供するための臨床的に有効な期間の終了を示す日時。</items>
                            <items id="comment">この日時は、サービス提供が可能な最も遅い日付、またはこの依頼の有効期限に相当する。例：予定手術など他のイベントの前にサービスを完了しなければならない場合がある。</items>
                        </term_definitions>
                        <term_definitions code="at0145">
                            <items id="text">サービス期間の開始</items>
                            <items id="description">このサービスを提供するための有効な期間の開始を示す日時。</items>
                            <items id="comment">この日時は、サービス提供が可能な最も早い日付に相当する。例：サービスを実施する前に一定の期間が経過していなければならないことがある。例えば、ある種の処置は患者が薬剤の服用を一定期間中止した後でなければ実施できない。</items>
                        </term_definitions>
                        <term_definitions code="at0147">
                            <items id="text">無期限？</items>
                            <items id="description">この依頼の有効期間には終わりがなく、有効期限がない。</items>
                            <items id="comment">依頼に有効期限がないことを明示的に記録するには TRUE として記録する。例：長期または生涯にわたるケアのための専門医への紹介で一般に必要となる。</items>
                        </term_definitions>
                        <term_definitions code="at0148">
                            <items id="text">サービス種別</items>
                            <items id="description">依頼するサービスの区分。</items>
                            <items id="comment">利用可能であれば、「サービス種別」はコード体系によりコード化することが望ましい。「サービス名」がコード化されていれば、このデータ項目をそのコードから導出できる場合がある。例：生化学または微生物学の検査室、超音波または CT の画像検査。</items>
                        </term_definitions>
                        <term_definitions code="at0149">
                            <items id="text">参考資料</items>
                            <items id="description">依頼を裏付け、または補足するための追加情報として提供される電子文書、画像、動画、または図。</items>
                        </term_definitions>
                        <term_definitions code="at0150">
                            <items id="text">備考</items>
                            <items id="description">他の項目には収まらないサービス依頼についての追加の記述。</items>
                        </term_definitions>
                        <term_definitions code="at0151">
                            <items id="text">複雑なタイミング</items>
                            <items id="description">一連のタイミングを必要とする複雑なサービス依頼に関する詳細情報。</items>
                            <items id="comment">例：「4時間は1時間ごと、その後20時間は4時間ごとのバイタルサイン観察」や「3週間ごとの水曜日に3回の来院」。</items>
                        </term_definitions>
                        <term_definitions code="at0152">
                            <items id="text">臨床的適応</items>
                            <items id="description">オーダーしたサービスの臨床的な理由。</items>
                            <items id="comment">可能であれば、臨床的適応は用語集によるコード化が望ましい。このデータエレメントは複数回の出現を許容する。例：「狭心症」や「1型糖尿病」。</items>
                        </term_definitions>
                        <term_definitions code="at0153">
                            <items id="text">オーダー詳細</items>
                            <items id="description">サービスをどのように提供すべきかに関する追加の詳細情報と指示。</items>
                            <items id="comment">可能であれば、オーダー詳細は用語集によるコード化が望ましい。このデータエレメントは複数回の出現を許容する。</items>
                        </term_definitions>
                    </children>
                    <children xsi:type="C_ARCHETYPE_ROOT">
                        <rm_type_name>EVALUATION</rm_type_name>
                        <occurrences>
                            <lower_included>true</lower_included>
                            <upper_included>true</upper_included>
                            <lower_unbounded>false</lower_unbounded>
                            <upper_unbounded>false</upper_unbounded>
                            <lower>0</lower>
                            <upper>1</upper>
                        </occurrences>
                        <node_id>at0000</node_id>
                        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                            <rm_attribute_name>data</rm_attribute_name>
                            <existence>
                                <lower_included>true</lower_included>
                                <upper_included>true</upper_included>
                                <lower_unbounded>false</lower_unbounded>
