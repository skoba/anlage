<% template = @composition.template %>
<h1>カルテ記録: <%= template.web_template["concept"] || template.template_id %></h1>
<p>保存日時: <%= @composition.created_at %></p>

<%# skoba/anlage#47: 保存後の次アクション（文言は docs/demo/ui-vocabulary.md） %>
<nav id="next_actions">
  <%= link_to "同じ帳票にもう 1 件入力", form_path(template.template_id) %>
  <%= link_to "カルテ記録一覧", compositions_path %>
  <%= link_to "AQL 照会", openehr_rails.query_console_path %>
  <%# skoba/anlage#102: FHIR プロファイルはテンプレートから決まるので、テンプレートの詳細に移した %>
  <%= link_to "テンプレートの詳細", template_path(template.template_id) %>
</nav>

<%# skoba/anlage#138: 修正と版の履歴（文言は docs/demo/ui-vocabulary.md） %>
<% versions = @composition.versions.to_a %>
<% if @composition.deleted? %>
  <p class="form-notice">このカルテ記録は削除済みです。</p>
<% elsif @composition.latest_version? %>
  <% if @editable %>
    <p><%= link_to "修正", edit_composition_path(@composition), id: "edit_composition" %></p>
  <% else %>
    <p class="form-notice">この記録は修正できません（読み戻せない形を含みます。<a href="https://github.com/skoba/anlage/issues/30">#30</a>）。</p>
  <% end %>
  <%# skoba/anlage#140: 削除は論理削除（削除の版を足す） %>
  <% if @composition.uid.present? %>
    <%= button_to "削除", composition_path(@composition), method: :delete, form: { data: { turbo_confirm: "このカルテ記録を削除しますか？" } } %>
  <% end %>
<% else %>
  <p class="form-notice">この版は置き換えられています。<%= link_to "最新の版を見る", composition_path(versions.last), id: "latest_version" %></p>
<% end %>

<%# skoba/anlage#191: 記録の中身（読むだけ）。並び・ラベル・単位・選択肢の表示はテンプレートから。文言は docs/demo/ui-vocabulary.md %>
<section id="record_contents">
  <h2>記録の中身</h2>
  <% if @readable %>
    <% Opt::FormLayout.call(template).each do |node| %>
      <%= render "compositions/record_group", node: node, values: @values %>
    <% end %>
  <% else %>
    <p class="form-notice">この記録は帳票の形に読み戻せません。項目の名前と値を、記録に書いてあるとおりに出します。</p>
    <table class="record-items">
      <thead><tr><th>名前</th><th>値</th></tr></thead>
      <tbody>
        <% Records::ElementList.call(@composition.rm_composition["content"]).each do |name, value| %>
          <tr><td><%= name %></td><td><%= value %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<h2 id="version_history">版の履歴</h2>
<ol class="versions">
  <% versions.each.with_index(1) do |version, number| %>
    <li>
      <% label = "版 #{number}（#{version.created_at}）" %>
      <% if version == @composition %>
        <%= label %>（この版）
      <% else %>
        <%= link_to label, composition_path(version) %>
      <% end %>
    </li>
  <% end %>
</ol>

<details>
  <summary>canonical JSON</summary>
  <pre><%= JSON.pretty_generate(@composition.rm_composition) %></pre>
</details>
