<h1>カルテ記録一覧</h1>

<% if @compositions.empty? %>
  <p>カルテ記録はまだありません。</p>
<% else %>
  <ul>
    <% @compositions.each do |composition| %>
      <li>
        <%= link_to "#{composition.template.template_id} — #{composition.created_at}", composition_path(composition) %>
      </li>
    <% end %>
  </ul>
<% end %>
