<%# skoba/anlage#47・#95: 文言は docs/demo/ui-vocabulary.md（正典）。engine の layout からも使うので、
    anlage の URL は main_app.、engine の URL は openehr_rails. を付けて呼ぶ。
    current: いまの画面の項目（:patients／:templates／:compositions／:pathcards／:queries／:aql） %>
<nav id="app_nav">
  <%# skoba/anlage#162（R-20261126-2 の 4）: 認証の無い参照実装であることを、どの画面でも最初に見せる %>
  <p id="reference_warning" role="note">参照実装です。認証がありません。実在の患者のデータを入れないでください。外から届く場所で動かさないでください。</p>
  <%= link_to "患者", main_app.patients_path, aria: { current: (current == :patients ? "page" : nil) } %>
  <%= link_to "テンプレート", main_app.templates_path, aria: { current: (current == :templates ? "page" : nil) } %>
  <%= link_to "カルテ記録一覧", main_app.compositions_path, aria: { current: (current == :compositions ? "page" : nil) } %>
  <%= link_to "パスカード検索", main_app.pathcards_search_path, aria: { current: (current == :pathcards ? "page" : nil) } %>
  <%= link_to "クエリビルダー", main_app.new_query_path, aria: { current: (current == :queries ? "page" : nil) } %>
  <%= link_to "AQL 照会", openehr_rails.query_console_path, aria: { current: (current == :aql ? "page" : nil) } %>
  <%# skoba/anlage#134: いまの患者（session[:ehr_id]）。engine の画面からも使うので、ヘルパーではなくここで引く。
      ナビのリンクを増やさないよう、選択の解除は button_to（form）にする %>
  <% current_patient = session[:ehr_id] && OpenehrRails::Rm::Ehr.find_by(ehr_id: session[:ehr_id]) %>
  <div id="current_patient">
    いまの患者:
    <% if current_patient %>
      <strong><%= current_patient.subject_id %></strong>
      <%= button_to "選択を外す", main_app.patient_selection_path, method: :delete %>
    <% else %>
      患者を選んでいません
    <% end %>
  </div>
</nav>
