<h1><%= @template.web_template["concept"] || @template.template_id %></h1>

<%# skoba/anlage#36: builder が扱えない形は閲覧専用（壇上で 500 を出さない） %>
<% if @template.preview_only? %>
  <p class="form-notice">保存は未対応（<a href="https://github.com/skoba/anlage/issues/30">#30</a>）: <%= @template.form_capability_reason %>。このフォームは閲覧専用です。</p>
<% end %>

<%# skoba/anlage#47 変更 4: 帳票の振る舞い（config/form_behaviors.yml）。即時表示はクライアント、権威はサーバ %>
<% behavior_rules = Opt::FormBehaviors.rules_for(@template.template_id) %>
<% behavior_data = behavior_rules.empty? ? {} : { controller: "form-behaviors", form_behaviors_rules_value: behavior_rules.to_json, action: "input->form-behaviors#recalculate" } %>
<%= form_with url: template_compositions_path(@template.template_id), method: :post, local: true, data: behavior_data do %>
  <fieldset>
    <% @template.fields.each do |field| %>
      <%= render "templates/field", field: field, disabled: @template.preview_only?,
                 value: @values[field["name"]], error: @errors[field["name"]] %>
    <% end %>
  </fieldset>

  <% unless @template.preview_only? %>
    <button type="submit">保存</button>
  <% end %>
<% end %>
