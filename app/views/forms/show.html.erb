<h1><%= @template.web_template["concept"] || @template.template_id %></h1>

<%# skoba/anlage#36: builder が扱えない形は閲覧専用（壇上で 500 を出さない） %>
<% if @template.preview_only? %>
  <p class="form-notice">保存は未対応（<a href="https://github.com/skoba/anlage/issues/30">#30</a>）: <%= @template.form_capability_reason %>。このフォームは閲覧専用です。</p>
<% end %>

<%# skoba/anlage#47 変更 4: 帳票の振る舞い（config/form_behaviors.yml）。即時表示はクライアント、権威はサーバ %>
<% behavior_rules = Opt::FormBehaviors.rules_for(@template.template_id) %>
<% behavior_data = behavior_rules.empty? ? {} : { controller: "form-behaviors", form_behaviors_rules_value: behavior_rules.to_json, action: "input->form-behaviors#recalculate" } %>
<%# R-20261125-1: 帳票全体が空のときの、帳票に付くメッセージ %>
<% if @errors&.key?("base") %>
  <p class="form-error"><%= @errors["base"] %></p>
<% end %>
<%# R-20261125-1: 必須の印の凡例（docs/demo/ui-vocabulary.md） %>
<% marks = @template.fields.map { |field| Opt::FormValidator.required_mark(field) }.compact.uniq %>
<% if marks.any? %>
  <p class="required-legend"><%= safe_join([ ("* 必須" if marks.include?(:always)), ("※ この枠に書くなら必須" if marks.include?(:if_written)) ].compact, "　") %></p>
<% end %>
<%# skoba/anlage#138: 修正の帳票（@composition があるとき）は、その記録への PATCH %>
<% form_url, form_method = @composition ? [ composition_path(@composition), :patch ] : [ template_compositions_path(@template.template_id), :post ] %>
<%= form_with url: form_url, method: form_method, local: true, data: behavior_data do %>
  <% Opt::FormLayout.call(@template).each do |node| %>
    <%= render "forms/root_group", node: node %>
  <% end %>

  <% unless @template.preview_only? %>
    <button type="submit">保存</button>
  <% end %>
<% end %>
