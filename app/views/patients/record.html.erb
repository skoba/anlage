<%# skoba/anlage#182: テンプレートが未登録の記録の閲覧（docs/design/m3-plan.md 8.2。文言は docs/demo/ui-vocabulary.md） %>
<h1>カルテ記録: <%= @record.name_value.presence || record_template_label(@record) %></h1>

<p class="form-notice">この記録のテンプレートは登録されていません。閲覧だけです。</p>

<dl class="record-summary">
  <dt>テンプレートの ID</dt><dd><%= record_template_label(@record) %></dd>
  <dt>記録日</dt><dd><%= recorded_date(@record.context_start_time) %></dd>
</dl>

<h2>項目</h2>
<table class="record-items">
  <thead><tr><th>名前</th><th>値</th></tr></thead>
  <tbody>
    <% Records::ElementList.call(@canonical["content"]).each do |name, value| %>
      <tr><td><%= name %></td><td><%= value %></td></tr>
    <% end %>
  </tbody>
</table>

<details>
  <summary>canonical JSON</summary>
  <pre><%= JSON.pretty_generate(@canonical) %></pre>
</details>

<p><%= link_to "患者: #{@patient.subject_id}", patient_path(@patient.ehr_id) %></p>
