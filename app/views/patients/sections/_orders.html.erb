<%# 部品 orders（skoba/anlage#281。もとは patients/_chart。docs/design/u1-patient-chart-plan.md 1.3〜1.5。文言は docs/demo/ui-vocabulary.md） %>
<% if chart.orders.any? %>
  <section id="orders" data-definition-section="<%= section.id %>" class="card">
    <h2>依頼と紹介状</h2>
    <table class="data-table">
      <thead><tr><th>記録日</th><th>テンプレート</th></tr></thead>
      <tbody>
        <% chart.orders.each do |order| %>
          <tr>
            <td><%= link_to recorded_date(order.at), chart_record_path(patient, order.record, originals) %></td>
            <td><%= order.template_id %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
