<%# 部品 time_series（skoba/anlage#281。もとは patients/_chart。docs/design/u1-patient-chart-plan.md 1.3〜1.5。文言は docs/demo/ui-vocabulary.md） %>
<% if chart.series.any? %>
  <section id="time_series" data-definition-section="<%= section.id %>" class="card">
    <h2>経過</h2>
    <% chart.series.each do |series| %>
      <figure class="series">
        <figcaption><%= "#{series.label}（#{series.template_id}、#{series.units}）" %></figcaption>
        <%= series_chart(series.points, units: series.units, label: series.label) %>
        <table class="data-table">
          <thead><tr><th>記録日</th><th class="number">値</th></tr></thead>
          <tbody>
            <% series.points.each do |point| %>
              <tr>
                <td><%= link_to recorded_date(point.at), chart_record_path(patient, point.record, originals) %></td>
                <td class="number"><%= point.display %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </figure>
    <% end %>
  </section>
<% end %>
