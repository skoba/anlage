<%# 部品 problem_list（skoba/anlage#281。もとは patients/_chart。docs/design/u1-patient-chart-plan.md 1.3〜1.5。文言は docs/demo/ui-vocabulary.md） %>
<% if chart.problems.any? %>
  <% labels = problem_list_labels(chart.problems.first) %>
  <section id="problem_list" data-definition-section="<%= section.id %>" class="card">
    <h2>プロブレムリスト</h2>
    <table class="data-table">
      <thead><tr><% (labels + [ "記録日" ]).each do |label| %><th><%= label %></th><% end %></tr></thead>
      <tbody>
        <% chart.problems.each do |problem| %>
          <tr>
            <td><%= link_to problem.diagnosis, chart_record_path(patient, problem.record, originals) %></td>
            <td><%= problem.certainty %></td>
            <td><%= problem.onset %></td>
            <td><%= recorded_date(problem.at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
