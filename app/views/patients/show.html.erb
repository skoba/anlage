<%# skoba/anlage#130: 文言は docs/demo/ui-vocabulary.md の「患者」の行 %>
<h1>患者: <%= @patient.subject_id %></h1>

<dl>
  <dt>患者 ID</dt><dd><%= @patient.subject_id %></dd>
  <dt>名前空間</dt><dd><%= @patient.subject_namespace %></dd>
  <%# skoba/anlage#192: EHR ID を写すボタン（AQL に貼るため。文言は docs/demo/ui-vocabulary.md） %>
  <dt>EHR ID</dt>
  <dd data-controller="clipboard">
    <code id="ehr_id" data-clipboard-target="source"><%= @patient.ehr_id %></code>
    <button type="button" data-action="clipboard#copy">EHR ID を写す</button>
    <span class="copy-status" data-clipboard-target="status" aria-live="polite"></span>
  </dd>
</dl>

<%# R-20261127-9: 問いに EHR ID を入れた状態で AQL 照会を開く（実行は画面のボタン）。文言は docs/demo/ui-vocabulary.md %>
<p><%= link_to "この患者の記録を AQL で引く", patient_records_aql_path(@patient), id: "patient_aql" %></p>

<%= render "patients/chart", definition: @definition, chart: @chart, patient: @patient, originals: @originals, records: @records %>

<%= button_to "この患者を選ぶ", select_patient_path(@patient.ehr_id) %>

<p><%= link_to "患者の一覧", patients_path %></p>
