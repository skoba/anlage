<h1>テンプレートの取り込み</h1>

<div data-controller="dropzone"
     data-dropzone-preview-url-value="<%= templates_preview_path %>"
     data-dropzone-register-url-value="<%= templates_path %>"
     data-action="dragover@window->dropzone#dragover dragenter@window->dropzone#dragenter dragleave@window->dropzone#dragleave drop@window->dropzone#drop">

  <div data-dropzone-target="overlay" id="dropzone_overlay">ドロップして取り込む</div>

  <%# skoba/anlage#47 変更 2: 主導線は「ファイルを選択」。ドラッグ＆ドロップはページ全体（@window）で受ける %>
  <button type="button" id="dropzone_hint" data-action="click->dropzone#browse">ファイルを選択</button>
  <p class="dropzone-help">.opt / .xml は登録、.json（Composition）・.adl（アーキタイプ）は中身の確認。ページのどこにでもドロップできます</p>
  <input type="file" id="opt_file_input" accept=".opt,.xml,.json,.adl" multiple hidden
         data-dropzone-target="fileInput"
         data-action="change->dropzone#fileSelected">

  <form data-action="submit->dropzone#importUrl">
    <input type="url" placeholder="https://ckm.openehr.org/..." data-dropzone-target="urlInput">
    <button type="submit">URLから取り込む</button>
  </form>

  <p id="upload_status"></p>
  <p id="queue_status" data-dropzone-target="queueStatus"></p>

  <turbo-frame id="fitting_room" data-dropzone-target="fittingRoom"></turbo-frame>

  <div id="catalog">
    <% if @templates.empty? %>
      <p id="empty_notice">テンプレートが未登録です。OPT ファイルを選択して取り込んでください</p>
    <% end %>
    <%= render @templates %>
  </div>
</div>
