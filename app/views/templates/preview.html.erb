<h2>テンプレートの取り込み: <%= @template.web_template["concept"] || @template.template_id %></h2>
<p>登録前に中身を確認します。</p>
<% registering_version = @superseding ? ::Template.next_version(@superseding.version) : @template.version %>
<p id="version_label"><%= version_label(registering_version, @template.sem_ver) %></p>

<% if @existing %>
  <p class="already-registered">登録済みです（v<%= @existing.version %>）。</p>
<% else %>
  <div id="parse_log" data-dropzone-target="parseLog"></div>

  <% parse_summary = @template.entries.map { |e| { concept: e["concept"] || e["archetype_id"], field_count: (e["fields"] || []).size } } %>
  <script type="application/json" data-dropzone-target="parseEntries"><%= json_escape(parse_summary.to_json).html_safe %></script>

  <div id="fitting_room_content" data-dropzone-target="fittingRoomContent" hidden>
    <dl>
      <dt>アーキタイプ数</dt><dd><%= @template.entries.size %></dd>
      <dt>項目数</dt><dd><%= @template.fields.size %></dd>
    </dl>

    <% if @superseding %>
      <div id="version_diff">
        <p>
          <%= @superseding.template_id %> は既に <%= version_label(@superseding.version, @superseding.sem_ver) %> として登録済みです。
          内容が変更されています。承認すると
          <%= version_label(registering_version, @template.sem_ver) %> として新規登録し、
          旧バージョンは superseded になります。
        </p>
        <% if @diff.any_changes? %>
          <% if @diff.added.any? %>
            <h4>追加されたフィールド</h4>
            <ul>
              <% @diff.added.each do |field| %>
                <li class="diff-added"><%= field["path"] %> (<%= field["label"] %>)</li>
              <% end %>
            </ul>
          <% end %>
          <% if @diff.removed.any? %>
            <h4>削除されたフィールド</h4>
            <ul>
              <% @diff.removed.each do |field| %>
                <li class="diff-removed"><%= field["path"] %> (<%= field["label"] %>)</li>
              <% end %>
            </ul>
          <% end %>
          <% if @diff.changed.any? %>
            <h4>変更されたフィールド</h4>
            <ul>
              <% @diff.changed.each do |change| %>
                <li class="diff-changed">
                  <%= change["path"] %>:
                  <%= change["before"].to_json %> → <%= change["after"].to_json %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% else %>
          <p>フィールド構成に差分はありません（内容のみ変更）。</p>
        <% end %>
      </div>
    <% end %>

    <h3>帳票の確認</h3>
    <fieldset>
      <%= render partial: "templates/field", collection: @template.fields, as: :field, locals: { disabled: true } %>
    </fieldset>

    <button type="button" data-action="click->dropzone#register">登録</button>
    <button type="button" data-action="click->dropzone#discard">破棄</button>
  </div>
<% end %>
