<h2>記入済みの帳票: <%= @composition_template.web_template["concept"] || @composition_template.template_id %></h2>
<p>この Composition は <%= @composition_template.template_id %>（<%= version_label(@composition_template.version, @composition_template.sem_ver) %>）のデータです。</p>

<fieldset>
  <% @composition_template.fields.each do |field| %>
    <%= render "templates/field", field: field, disabled: true, value: @composition_values[field["name"]] %>
  <% end %>
</fieldset>

<button type="button" data-action="click->dropzone#discard">閉じる</button>
