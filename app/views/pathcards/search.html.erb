<h1>パスカード検索</h1>

<%= form_with url: pathcards_search_path, method: :get do |form| %>
  <%= form.label :q, "探したい項目" %>
  <%= form.search_field :q, value: @query %>
  <%= form.submit "検索" %>
<% end %>

<section id="pathcard-results">
  <%= render partial: "pathcard", collection: @pathcards %>
</section>
