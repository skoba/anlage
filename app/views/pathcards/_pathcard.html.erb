<article class="pathcard">
  <% identity = pathcard.fetch("identity") %>
  <% label = pathcard.dig("semantics", "labels", 0) %>
  <% semantic_entries = Array(pathcard.dig("semantics", "labels")) +
                        Array(pathcard.dig("semantics", "descriptions")) %>
  <h2><%= label&.fetch("text", nil) || identity.fetch("at_code") %></h2>
  <dl>
    <dt>テンプレート</dt>
    <dd><%= identity.fetch("template_id") %></dd>
    <dt>アーキタイプ</dt>
    <dd><%= identity.fetch("archetype_id") %></dd>
    <dt>ノード</dt>
    <dd><%= identity.fetch("at_code") %></dd>
  </dl>
  <%= link_to "帳票に入力", form_path(identity.fetch("template_id")) %>
  <% if semantic_entries.any? { |entry| entry["untranslated_suspect"] } %>
    <p class="pathcard-warning">未翻訳の疑いがあります</p>
  <% end %>
</article>
